{
  "$schema": "https://registry.tabularis.dev/manifest.schema.json?kind=driver",
  "id": "harper",
  "name": "Harper",
  "version": "0.1.2",
  "description": "Tabularis driver plugin for Harper",
  "kind": "driver",
  "engine": "harper",
  "paradigms": [
    "document",
    "sql",
    "key-value",
    "vector"
  ],
  "default_port": 9925,
  "default_username": "",
  "executable": "harper",
  "connection_metadata": true,
  "capabilities": {
    "schemas": false,
    "views": false,
    "routines": false,
    "file_based": false,
    "folder_based": false,
    "no_connection_required": false,
    "identifier_quote": "`",
    "sql_dialect": "mysql",
    "alter_primary_key": false,
    "alter_column": false,
    "create_foreign_keys": false,
    "manage_tables": true,
    "readonly": false,
    "supports_ssl": true
  },
  "data_types": [
    {
      "name": "ANY",
      "category": "other",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "INTEGER",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "BIGINT",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "LONG",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "FLOAT",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "TEXT",
      "category": "string",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "VARCHAR",
      "category": "string",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "BOOLEAN",
      "category": "other",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "DATE",
      "category": "date",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "BYTES",
      "category": "binary",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "BLOB",
      "category": "binary",
      "requires_length": false,
      "requires_precision": false
    }
  ],
  "icon": "https://raw.githubusercontent.com/HarperFast/tabularis-harper-plugin/v0.1.2/harper.png"
}
